.s-npc-sprite-container {
    flex-grow: 1;
    align-items: flex-end;
    justify-content: flex-end;
    margin-bottom: 65px;
    margin-right: 65px;
}

.s-npc-sprite-container-alt {
    flex-grow: 1;
    align-items: flex-start;
    justify-content: flex-end;
    margin-bottom: 65px;
    margin-right: 0;
    margin-left: 65px;
}

.s-npc-sprite {
    -unity-background-scale-mode: scale-to-fit;
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    background-image: url('project://database/Assets/Data/Characters/Whale.PNG?fileID=2800000&guid=2f9b420922044f346897567d72563237&type=3#Whale');
    color: rgba(210, 210, 210, 0);
    background-color: rgba(0, 0, 0, 0);
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
}

.s-npc-sprite-container-alt > .s-npc-sprite {
    width: 500px;
    height: 500px;
    max-width: 500px;
    max-height: 500px;
}

.s-npc-sprite-container > .s-npc-sprite {
    width: 500px;
    height: 500px;
    max-width: 500px;
    max-height: 500px;
}

.s-npc-sprite:disabled {
    -unity-background-image-tint-color: rgba(255, 255, 255, 255);
    color: rgba(255, 255, 255, 255);
    opacity: 1;
}
