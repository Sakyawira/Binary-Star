.s-npc-sprite-container {
    flex-grow: 1;
    align-items: flex-end;
    justify-content: flex-end;
    margin-bottom: 13px;
    margin-right: 260px;
}

.s-npc-sprite-container-alt {
    flex-grow: 1;
    align-items: flex-start;
    justify-content: flex-end;
    margin-bottom: 13px;
    margin-right: 0;
    margin-left: 260px;
}

.s-background-sprite-container-start {
    flex-grow: 1;
    align-items: flex-end;
    justify-content: flex-end;
    margin-bottom: 0px;
    margin-right: 130px;
}

.s-background-sprite-container-alt-start {
    flex-grow: 1;
    align-items: flex-start;
    justify-content: flex-end;
    margin-bottom: 0px;
    margin-right: 0;
    margin-left: 130px;
}

.s-background-sprite-container-end {
    flex-grow: 1;
    align-items: flex-end;
    justify-content: flex-end;
    margin-bottom: 39px;
    margin-right: 81px;
    transition-property: margin-bottom, margin-right;
    transition-duration: 10s, 10s;
}

.s-background-sprite-container-alt-end {
    flex-grow: 1;
    align-items: flex-start;
    justify-content: flex-end;
    margin-bottom: 39px;
    margin-right: 0;
    margin-left: 81px;
    transition-property: margin-bottom, margin-left;
    transition-duration: 10s, 10s;
}

.s-npc-sprite {
    -unity-background-scale-mode: scale-to-fit;
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    background-image: url('project://database/Assets/Data/Characters/Whale.PNG?fileID=2800000&guid=2f9b420922044f346897567d72563237&type=3#Whale');
    color: rgba(210, 210, 210, 0);
    background-color: rgba(0, 0, 0, 0);
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
}

.s-npc-sprite:disabled {
    -unity-background-image-tint-color: rgb(255, 255, 255);
    color: rgb(255, 255, 255);
    opacity: 1;
}

.s-npc-sprite-zoom-in {
    width: 463px;
    height: 542px;
    max-width: 463px;
    max-height: 542px;
    transition-property: max-width, width, height, max-height;
    transition-duration: 10s, 10s, 10s, 10s;
}

.s-npc-sprite-zoom-out {
    width: 231px;
    height: 271px;
    max-width: 231px;
    max-height: 271px;
    transition-property: max-width, width, height, max-height;
    transition-duration: 10s, 10s, 10s, 10s;
}

.s-background-sprite-zoom-in {
    width: 910px;
    height:  910px;
    max-width:  910px;
    max-height:  910px;
    transition-property: max-width, width, height, max-height;
    transition-duration: 10s, 10s, 10s, 10s;
}

.s-background-sprite-zoom-out {
    width: 975px;
    height: 975px;
    max-width: 975px;
    max-height: 975px;
    transition-property: max-width, width, height, max-height;
    transition-duration: 10s, 10s, 10s, 10s;
}