.s-npc-sprite-container {
    flex-grow: 1;
    align-items: flex-end;
    justify-content: flex-end;
    margin-bottom: 260px;
    margin-right: 360px;
}

.s-npc-sprite-container-alt {
    flex-grow: 1;
    align-items: flex-start;
    justify-content: flex-end;
    margin-bottom: 260px;
    margin-right: 0;
    margin-left: 360px;
}

.s-npc-sprite {
    -unity-background-scale-mode: scale-to-fit;
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    background-image: url('project://database/Assets/Data/Characters/Whale.PNG?fileID=2800000&guid=2f9b420922044f346897567d72563237&type=3#Whale');
    color: rgba(210, 210, 210, 0);
    background-color: rgba(0, 0, 0, 0);
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
}

.s-npc-sprite:disabled {
    -unity-background-image-tint-color: rgb(255, 255, 255);
    color: rgb(255, 255, 255);
    opacity: 1;
}

.s-npc-sprite-start {
    width: 650;
    height: 650;
    max-width: 650;
    max-height: 650;
}

.s-npc-sprite-end {
    width: 325px;
    height: 325px;
    max-width: 325px;
    max-height: 325px;
    transition-property: max-width, width, height, max-height;
    transition-duration: 1s, 1s, 1s, 1s;
}
