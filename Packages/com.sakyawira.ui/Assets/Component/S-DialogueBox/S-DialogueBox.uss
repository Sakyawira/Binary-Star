.s-dialogue-box-container {
    flex-grow: 1;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
}

.s-dialogue-box {
    justify-content: flex-start;
    flex-grow: 1;
    height: auto;
    max-height: 230px;
    max-width: 1920px;
    flex-shrink: 1;
    flex-direction: row;
    background-color: rgba(217, 217, 217, 0.49);
    margin-left: 50px;
    margin-right: 50px;
    margin-bottom: 0;
    width: auto;
    flex-wrap: wrap;
    margin-top: 50px;
}

.s-dialogue-box-text {
    flex-wrap: nowrap;
    margin-left: 0;
    font-size: 39px;
    -unity-font-style: normal;
    color: rgb(0, 0, 0);
    margin-top: 25px;
    flex-grow: 1;
    white-space: normal;
    -unity-text-align: upper-center;
}

.s-dialogue-box-text-container {
    align-items: center;
    justify-content: flex-start;
    flex-grow: 1;
    flex-direction: column;
    flex-shrink: 0;
}
