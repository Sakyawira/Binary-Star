.s-dialogue-box-container {
    flex-grow: 1;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
}

.s-dialogue-box {
    justify-content: flex-start;
    flex-grow: 1;
    height: auto;
    max-height: 230px;
    max-width: 1920px;
    flex-shrink: 1;
    flex-direction: row;
    background-color: rgba(217, 217, 217, 0);
    margin-left: 50px;
    margin-right: 50px;
    margin-bottom: 0;
    width: auto;
    flex-wrap: wrap;
    margin-top: 195px;
}

.s-dialogue-box-text {
    flex-wrap: nowrap;
    margin-left: 0;
    font-size: 39px;
    -unity-font-style: normal;
    color: rgb(255, 255, 255);
    margin-top: 25px;
    flex-grow: 1;
    white-space: normal;
    -unity-text-align: upper-center;
    -unity-font-definition: url('project://database/Assets/Fonts%20&%20Materials/Exo2-VariableFont_wght%20SDF.asset?fileID=11400000&guid=57fd4bb8508c4f24d83cc149090d37e6&type=2#Exo2-VariableFont_wght SDF');
}

.s-dialogue-box-text-container {
    align-items: center;
    justify-content: flex-start;
    flex-grow: 1;
    flex-direction: column;
    flex-shrink: 0;
}

.s-dialogue-box-transition {
    transition-property: scale, translate;
    scale: 0.5 0.5;
    transition-duration: 0.5s, 0.5s;
    translate: 0 -130px;
}
